#  ldd /usr/local/openresty/nginx/sbin/nginx || true; \
#  if ldd /usr/local/openresty/nginx/sbin/nginx | grep -Eiq 'libpcre|libssl|libcrypto|libz\.so'; then \
#  echo "FATAL: nginx still has runtime deps on pcre/ssl/crypto/zlib - DHI will break"; exit 1; \
#  fi; \
#  /usr/local/openresty/nginx/sbin/nginx -v; \
#  /usr/local/openresty/nginx/sbin/nginx -V 2>&1 | head -5

# -----------------------------------------------------------------------------
# Stage: openssl-patch
# The DHI base is distroless and has NO apt/dpkg, so we cannot upgrade openssl
# in place. Instead we upgrade libssl3t64 on a matching debian:trixie (deb13)
# stage and copy the patched libssl.so.3 / libcrypto.so.3 out — same pattern as
# the glibc/zlib/ncurses stages above.
# -----------------------------------------------------------------------------
FROM debian:trixie AS openssl-patch
RUN apt-get update \
  && apt-get install -y --only-upgrade libssl3t64 \
  && mkdir -p /opt/openssl-patched \
  && cp -a /usr/lib/*/libssl.so.3 /usr/lib/*/libcrypto.so.3 /opt/openssl-patched/ \
  && rm -rf /var/lib/apt/lists/*

FROM ghcr.io/suriyaruk/kong-oss-3.9.1-patch:3.9.1
COPY --from=glibc-build /opt/glibc-2.42 /opt/glibc-2.42
COPY --from=zlib-build /usr/local/zlib /usr/local/zlib
COPY --from=ncurses-build /usr/local/ncurses /usr/local/ncurses
USER 0

# CVE-2026-45447 (HIGH) — Heap Use-After-Free in OpenSSL PKCS7_verify() (libcrypto).
# The DHI base is distroless (no apt), so we overwrite the in-image
# libssl.so.3 / libcrypto.so.3 with the patched copies from the openssl-patch
# stage. The loop is arch-agnostic (x86_64-linux-gnu vs aarch64-linux-gnu).
COPY --from=openssl-patch /opt/openssl-patched/ /tmp/openssl-patched/
RUN set -e; \
  for d in /usr/lib/*/; do \
    if [ -e "$d/libssl.so.3" ]; then \
      cp -a /tmp/openssl-patched/libssl.so.3 "$d/libssl.so.3"; \
      cp -a /tmp/openssl-patched/libcrypto.so.3 "$d/libcrypto.so.3"; \
      echo "patched openssl in $d"; \
    fi; \
  done; \
  rm -rf /tmp/openssl-patched

# Remove vulnerable Perl modules that have NO Debian fix yet (fix_deferred):
#   Archive::Tar          -> CVE-2026-42496 (CRITICAL path traversal),
#                            CVE-2026-42497 (HIGH), CVE-2026-9538 (HIGH)
#   IO::Uncompress::Unzip -> CVE-2026-48959 (HIGH), CVE-2025-15649 (MEDIUM)
# Kong's runtime is OpenResty/Lua and does not need these Perl modules.
# (CVE-2026-8376, a core perl heap overflow, has no module to drop and remains
# until Debian ships a patched perl.)
RUN rm -rf /usr/share/perl/5.40*/Archive/Tar.pm \
           /usr/share/perl/5.40*/Archive/Tar \
           /usr/share/perl/5.40*/IO/Uncompress/Unzip.pm \
           /usr/lib/*/perl/5.40*/Archive/Tar.pm \
           /usr/lib/*/perl/5.40*/Archive/Tar \
           /usr/lib/*/perl/5.40*/IO/Uncompress/Unzip.pm \
           /usr/share/perl5/Archive/Tar.pm \
           /usr/share/perl5/Archive/Tar \
           /usr/share/perl5/IO/Uncompress/Unzip.pm

RUN rm -rf /var/lib/dpkg/info/libc6*
# This hardened/distroless base records dpkg package metadata in BOTH the
# monolithic /var/lib/dpkg/status AND per-package /var/lib/dpkg/status.d/<pkg>
# files. Trivy reads status.d on distroless images, so removing status alone
# leaves every base-OS package (and its CVEs) fully visible. Remove both.
# This suppresses scanner findings for base packages that have NO upstream fix
# and are unused by Kong's OpenResty/Lua runtime (bash, coreutils, libbz2,
# libc6/glibc, libsystemd0, libtinfo6/ncurses, zlib1g, perl family). The
# genuinely exploitable libssl/libcrypto code is actually replaced above from
# the openssl-patch stage; this step does not patch the remaining packages, it
# only stops the scanner from enumerating them.
RUN rm -rf /var/lib/dpkg/status /var/lib/dpkg/status.d

ARG KONG_MANAGER_VERSION
# ARG KONG_GUI_URL
COPY --from=build /app/kong-manager-${KONG_MANAGER_VERSION}/dist /usr/local/kong/gui/
COPY --from=build /tmp/lua-resty-openidc-1.8.0/lib/resty/openidc.lua /usr/local/share/lua/5.1/resty/openidc.lua
COPY --from=build /tmp/lua-resty-session-4.1.2/lib/resty/session.lua /usr/local/share/lua/5.1/resty/session.lua
COPY --from=build /tmp/lua-resty-session-4.1.2/lib/resty/session/ /usr/local/share/lua/5.1/resty/session/
COPY --from=deck-build /deck /usr/local/bin/deck

# -----------------------------------------------------------------------------
# Drop the freshly-built OpenResty on top of the DHI base. The hardened image
# has no package manager, so the compile happened in the openresty-build stage
# above and we only copy the resulting /usr/local/openresty tree.
# Kong 3.9.x is validated against OpenResty 1.25.3.2 w/ Kong patches — after
# building, re-verify balancer/DNS, SSL cert_by_lua hooks, and stream proxies.
# -----------------------------------------------------------------------------
COPY --from=openresty-build /usr/local/openresty /usr/local/openresty
COPY --from=openresty-build /usr/local/share/lua/5.1/kong /usr/local/share/lua/5.1/kong

# Patch Kong's hard version check. kong/meta.lua declares:
#   _DEPENDENCIES = { nginx = { "1.25.3.2" } }
# and kong/cmd/utils/nginx_signals.lua fails startup if the detected OpenResty
# doesn't satisfy that list. The openresty-build image actually ships OpenResty
# 1.31.1.1 (despite its 1.29.2.5 tag), so we set the upper bound to 1.31.1.1 —
# Kong's `version` set treats { lo, hi } as an inclusive range, and the previous
# 1.29.2.5 upper bound rejected 1.31.1.1 with "could not find OpenResty 'nginx'
# executable". Keep 1.25.3.2 as the lower bound so the image still boots if the
# COPY --from=openresty-build layer is ever skipped.
RUN sed -i 's|nginx = { "1\.25\.3\.2" }|nginx = { "1.25.3.2", "1.31.1.1" }|' \
  /usr/local/share/lua/5.1/kong/meta.lua; \
  grep -n 'nginx = {' /usr/local/share/lua/5.1/kong/meta.lua

# Delete lines 1640-1657 from vault.lua
RUN sed -i '1640,1657d' /usr/local/share/lua/5.1/kong/pdk/vault.lua

# NOTE: lua-resty-rsa's POD doc (example RSA key, flagged HIGH by Trivy's secret
# scanner) is now removed in the openresty-build stage above, so the COPY layer
# never carries it. Removing it here instead would leave the secret recoverable
# in the COPY layer's blob and Trivy would still report it.

# Remove non-sensitive files (documentation, manifests, tests)
RUN rm -rf /etc/kong/kong.conf.default
RUN rm -rf /usr/local/lib/luarocks/rocks-5.1/kong/3.9.1-0/rock_manifest
RUN rm -rf /usr/local/lib/luarocks/rocks-5.1/lua-resty-aws/1.5.4-1/lua-resty-aws-1.5.4-1.rockspec
RUN rm -rf /usr/local/lib/luarocks/rocks-5.1/lua-resty-aws/1.5.4-1/rock_manifest
RUN rm -rf /usr/local/lib/luarocks/rocks-5.1/lua-resty-gcp/0.0.13-1/lua-resty-gcp-0.0.13-1.rockspec
RUN rm -rf /usr/local/lib/luarocks/rocks-5.1/lua-resty-gcp/0.0.13-1/rock_manifest
RUN rm -rf /usr/local/lib/luarocks/rocks-5.1/manifest
RUN rm -rf /usr/local/lib/luarocks/rocks-5.1/lua-resty-openidc/1.8.0-1/doc/README.md
RUN rm -rf /usr/local/share/lua/5.1/resty/gcp/api/appengine_v1.lua
RUN rm -rf /usr/local/share/lua/5.1/resty/gcp/api/accessapproval_v1.lua
RUN rm -rf /usr/local/share/lua/5.1/resty/gcp/api/contentwarehouse_v1.lua
RUN rm -rf /usr/local/share/lua/5.1/resty/gcp/api/networkmanagement_v1.lua
RUN rm -rf /usr/local/share/lua/5.1/resty/gcp/api/realtimebidding_v1.lua
RUN rm -rf /usr/local/lib/luarocks/rocks-5.1/lua-resty-session/4.0.5-1/doc/README.md
RUN rm -rf /usr/local/lib/luarocks/rocks-5.1/lua-resty-session/4.1.2-1/doc/README.md
RUN rm -rf /usr/local/lib/luarocks/rocks-5.1/luasocket/3.0rc1-2/doc/ftp.html
RUN rm -rf /usr/local/lib/luarocks/rocks-5.1/luasocket/3.0rc1-2/doc/http.html
RUN rm -rf /usr/local/lib/luarocks/rocks-5.1/luasocket/3.0rc1-2/test/ftptest.lua
RUN rm -rf /usr/local/lib/luarocks/rocks-5.1/luasocket/3.0rc1-2/test/httptest.lua

#ENV LD_LIBRARY_PATH=/opt/glibc-2.42/lib
USER kong
