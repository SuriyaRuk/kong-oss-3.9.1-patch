# =============================================================================
# Kong 3.9.2 (OpenResty 1.31.1.1) + Kong Manager + OIDC on Docker Hardened
# Image (Alpine). See Dockerfile.DHI-without-oidc for the base mechanics; this
# variant additionally bundles Kong Manager, lua-resty-openidc / -session and
# the deck CLI.
# =============================================================================

ARG KONG_MANAGER_VERSION=3.9.0.0

# -----------------------------------------------------------------------------
# Stage: build — Kong Manager UI + extra Lua libs (OIDC/session) + deck CLI.
# -----------------------------------------------------------------------------
FROM node:22-alpine AS build
ARG KONG_MANAGER_VERSION
# TARGETARCH is provided automatically by buildx (amd64 / arm64) and matches
# deck's release asset naming exactly.
ARG TARGETARCH
ARG DECK_VERSION=1.57.0
WORKDIR /app

RUN apk add --no-cache bash curl unzip
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN curl -fsSL https://github.com/Kong/kong-manager/archive/refs/tags/v${KONG_MANAGER_VERSION}.zip \
  -o v${KONG_MANAGER_VERSION}.zip && \
  curl -fsSL https://github.com/zmartzone/lua-resty-openidc/archive/refs/tags/v1.8.0.tar.gz | tar xz -C /tmp && \
  curl -fsSL https://github.com/bungle/lua-resty-session/archive/refs/tags/v4.1.2.tar.gz | tar xz -C /tmp

# deck CLI — fetch the build-target architecture (amd64 or arm64).
RUN curl -fsSL "https://github.com/Kong/deck/releases/download/v${DECK_VERSION}/deck_${DECK_VERSION}_linux_${TARGETARCH}.tar.gz" \
  | tar -xz -C /tmp

RUN npm install -g pnpm@latest

RUN unzip v${KONG_MANAGER_VERSION}.zip \
  && cd kong-manager-${KONG_MANAGER_VERSION} \
  && pnpm install

ARG NODE_ENV=production

COPY ./patch/App.vue /app/kong-manager-${KONG_MANAGER_VERSION}/src/App.vue
RUN cd kong-manager-${KONG_MANAGER_VERSION} \
  && pnpm build

# -----------------------------------------------------------------------------
# Stage: glibc — glibc runtime (+ libstdc++ for Kong's C++/Rust native libs).
# Debian trixie (glibc 2.41, GCC 14) so libstdc++ provides CXXABI_1.3.15 which
# Kong's libada/libsimdjson_ffi/libsnappy require.
# -----------------------------------------------------------------------------
FROM debian:trixie AS glibc
RUN set -eux; \
  apt-get update; \
  apt-get install -y --no-install-recommends libstdc++6; \
  rm -rf /var/lib/apt/lists/*; \
  arch="$(dpkg --print-architecture)"; \
  case "$arch" in \
    amd64) mdir=x86_64-linux-gnu;  interp=/lib64/ld-linux-x86-64.so.2 ;; \
    arm64) mdir=aarch64-linux-gnu; interp=/lib/ld-linux-aarch64.so.1 ;; \
    *) echo "unsupported arch: $arch" >&2; exit 1 ;; \
  esac; \
  mkdir -p /glibc/lib; \
  cp -a /lib/"$mdir"/. /glibc/lib/; \
  cp -a /usr/lib/"$mdir"/libstdc++.so* /glibc/lib/ 2>/dev/null || true; \
  cp -aL "$interp" /glibc/ld.so; \
  printf '%s' "$interp" > /glibc/interp-path

# -----------------------------------------------------------------------------
# Stage: kong-deb — download + extract the prebuilt Kong 3.9.2 .deb.
# -----------------------------------------------------------------------------
FROM debian:bookworm AS kong-deb
ARG KONG_DEB_VERSION=3.9.2
ARG KONG_OPENRESTY=1.31.1.1
ARG KONG_DEB_BASEURL=https://raw.githubusercontent.com/SuriyaRuk/kong-build-from-source/main/output
RUN set -eux; \
  apt-get update; \
  apt-get install -y --no-install-recommends curl ca-certificates; \
  rm -rf /var/lib/apt/lists/*; \
  arch="$(dpkg --print-architecture)"; \
  url="${KONG_DEB_BASEURL}/kong-${KONG_DEB_VERSION}-openresty${KONG_OPENRESTY}.${arch}.deb"; \
  echo ">>> Downloading $url"; \
  curl -fSL --retry 3 -o /tmp/kong.deb "$url"; \
  mkdir -p /kongroot; \
  dpkg-deb -x /tmp/kong.deb /kongroot; \
  rm -f /tmp/kong.deb

# -----------------------------------------------------------------------------
# Stage: depfill — keep only the dependency files the .deb is MISSING (diffed
# against the complete Kong 3.9.1 image), so none of 3.9.2's files are
# overwritten/downgraded.
# -----------------------------------------------------------------------------
FROM debian:bookworm AS depfill
COPY --from=ghcr.io/suriyaruk/kong-oss-3.9.1-patch:3.9.1 /usr/local /base
COPY --from=kong-deb /kongroot/usr/local /deb
RUN set -eux; \
  mkdir -p /delta; \
  cd /base; \
  for d in share/lua/5.1 lib/lua/5.1 kong/lib openresty/site/lualib; do \
    [ -d "$d" ] || continue; \
    find "$d" \( -type f -o -type l \) | while read -r f; do \
      if [ ! -e "/deb/$f" ] && [ ! -L "/deb/$f" ]; then \
        mkdir -p "/delta/$(dirname "$f")"; \
        cp -a "$f" "/delta/$f"; \
      fi; \
    done; \
  done; \
  echo "delta files: $(find /delta -type f -o -type l | wc -l)"

# -----------------------------------------------------------------------------
# Final stage: hardened Alpine base.
# -----------------------------------------------------------------------------
FROM suriyaruk/alpine-base:3.24-alpine3.24-dev-dhi
USER 0

# bash  -> required by Kong's docker-entrypoint.sh (uses bash-only syntax)
# perl  -> required by OpenResty's `resty` CLI (a Perl script) used by `kong`
RUN apk add --no-cache bash perl

# --- glibc runtime for the (glibc-linked) Kong/OpenResty binaries -----------
COPY --from=glibc /glibc/lib /opt/glibc/lib
COPY --from=glibc /glibc/ld.so /opt/glibc/ld.so
COPY --from=glibc /glibc/interp-path /tmp/interp-path
RUN set -eux; \
  ip="$(cat /tmp/interp-path)"; \
  mkdir -p "$(dirname "$ip")"; \
  ln -sf /opt/glibc/ld.so "$ip"; \
  rm -f /tmp/interp-path
ENV LD_LIBRARY_PATH=/opt/glibc/lib:/usr/local/kong/lib:/usr/local/openresty/luajit/lib \
    PATH=/usr/local/openresty/bin:/usr/local/openresty/nginx/sbin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin

# --- Kong runtime (extracted from the .deb) ---------------------------------
COPY --from=kong-deb /kongroot/usr/local /usr/local
COPY --from=kong-deb /kongroot/etc/kong /etc/kong

# --- Dependency modules missing from the .deb (Lua + native), delta only -----
# (See the `depfill` stage.) The WASM nginx module is intentionally excluded:
# it is compiled against the old OpenResty and is only loaded when `wasm = on`.
COPY --from=depfill /delta/ /usr/local/

# --- Kong's docker entrypoint (not shipped in the .deb) ----------------------
COPY --from=ghcr.io/suriyaruk/kong-oss-3.9.1-patch:3.9.1 /docker-entrypoint.sh /docker-entrypoint.sh

# Accept OpenResty 1.31.1.1 in Kong's hard nginx version check.
RUN sed -i 's|nginx = { "1\.25\.3\.2" }|nginx = { "1.25.3.2", "1.31.1.1" }|' \
  /usr/local/share/lua/5.1/kong/meta.lua; \
  grep -n 'nginx = {' /usr/local/share/lua/5.1/kong/meta.lua

# Repair the .deb's `kong` CLI: its packaging globally replaced `resty` with the
# absolute path, mangling Lua identifiers (e.g. `resty_cmd`). Revert to the
# bareword `resty` (resolved via PATH).
RUN sed -i 's|/usr/local/openresty/bin/resty|resty|g' /usr/local/bin/kong; \
  head -1 /usr/local/bin/kong

# -----------------------------------------------------------------------------
# OIDC / Kong Manager additions
# -----------------------------------------------------------------------------
ARG KONG_MANAGER_VERSION
COPY --from=build /app/kong-manager-${KONG_MANAGER_VERSION}/dist /usr/local/kong/gui/
COPY --from=build /tmp/lua-resty-openidc-1.8.0/lib/resty/openidc.lua /usr/local/share/lua/5.1/resty/openidc.lua
COPY --from=build /tmp/lua-resty-session-4.1.2/lib/resty/session.lua /usr/local/share/lua/5.1/resty/session.lua
COPY --from=build /tmp/lua-resty-session-4.1.2/lib/resty/session/ /usr/local/share/lua/5.1/resty/session/
COPY --from=build /tmp/deck /usr/local/bin/deck

# Delete the @usage doc comment block (lines 1640-1657) from vault.lua.
RUN sed -i '1640,1657d' /usr/local/share/lua/5.1/kong/pdk/vault.lua

# Remove non-sensitive files (documentation, manifests, tests). Harmless no-ops
# if a path is absent in this build's layout.
RUN rm -rf /etc/kong/kong.conf.default
RUN rm -rf /usr/local/lib/luarocks/rocks-5.1/kong/3.9.2-0/rock_manifest
RUN rm -rf /usr/local/lib/luarocks/rocks-5.1/lua-resty-aws/1.5.4-1/lua-resty-aws-1.5.4-1.rockspec
RUN rm -rf /usr/local/lib/luarocks/rocks-5.1/lua-resty-aws/1.5.4-1/rock_manifest
RUN rm -rf /usr/local/lib/luarocks/rocks-5.1/lua-resty-gcp/0.0.13-1/lua-resty-gcp-0.0.13-1.rockspec
RUN rm -rf /usr/local/lib/luarocks/rocks-5.1/lua-resty-gcp/0.0.13-1/rock_manifest
RUN rm -rf /usr/local/lib/luarocks/rocks-5.1/manifest
RUN rm -rf /usr/local/share/lua/5.1/resty/gcp/api/appengine_v1.lua
RUN rm -rf /usr/local/share/lua/5.1/resty/gcp/api/accessapproval_v1.lua
RUN rm -rf /usr/local/share/lua/5.1/resty/gcp/api/contentwarehouse_v1.lua
RUN rm -rf /usr/local/share/lua/5.1/resty/gcp/api/networkmanagement_v1.lua
RUN rm -rf /usr/local/share/lua/5.1/resty/gcp/api/realtimebidding_v1.lua

# --- kong user (uid/gid 65532; reuse the base's existing `nonroot` id) --------
RUN set -eux; \
  grep -q '^kong:' /etc/group  || echo 'kong:x:65532:' >> /etc/group; \
  grep -q '^kong:' /etc/passwd || echo 'kong:x:65532:65532:kong:/home/kong:/bin/sh' >> /etc/passwd; \
  mkdir -p /usr/local/kong /home/kong; \
  chown -R 65532:65532 /usr/local/kong /etc/kong /home/kong; \
  chmod +x /docker-entrypoint.sh /usr/local/bin/deck

EXPOSE 8000 8443 8001 8444 8002 8445 8003 8446 8004 8447
STOPSIGNAL SIGQUIT
USER kong
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["kong", "docker-start"]
