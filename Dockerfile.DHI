#  --add-module=/tmp/lua-resty-lmdb \
#  --add-module=/tmp/lua-resty-events \
#  --with-compat \
#  -j"$(nproc)"; \
#  make -j"$(nproc)"; \
#  make install; \
#  # Sanity: confirm no runtime deps on libpcre / libssl / libcrypto / libz
