ARG KONG_MANAGER_VERSION=3.9.0.0
# ARG KONG_GUI_URL=http://localhost/kong-manager

FROM node:22-alpine AS build
ARG KONG_MANAGER_VERSION
# ARG KONG_GUI_URL
WORKDIR /app

# Download Kong Manager source and Lua libraries
RUN apk add --no-cache bash curl unzip
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN curl -fsSL https://github.com/Kong/kong-manager/archive/refs/tags/v${KONG_MANAGER_VERSION}.zip \
  -o v${KONG_MANAGER_VERSION}.zip && \
  curl -fsSL https://github.com/zmartzone/lua-resty-openidc/archive/refs/tags/v1.8.0.tar.gz | tar xz -C /tmp && \
  curl -fsSL https://github.com/bungle/lua-resty-session/archive/refs/tags/v4.1.2.tar.gz | tar xz -C /tmp

RUN npm install -g pnpm@latest

RUN unzip v${KONG_MANAGER_VERSION}.zip \
  && cd kong-manager-${KONG_MANAGER_VERSION} \
  && pnpm install

ARG NODE_ENV=production
# ARG DISABLE_BASE_PATH=true

COPY ./patch/App.vue /app/kong-manager-${KONG_MANAGER_VERSION}/src/App.vue
RUN cd kong-manager-${KONG_MANAGER_VERSION} \
  && pnpm build

# -----------------------------------------------------------------------------
# Stage: deck-build
# The published deck v1.63.0 binary is compiled with Go 1.25.7, which carries
# 12 HIGH Go-stdlib CVEs (CVE-2026-25679, -32280/81/83, -33811/14, -39820/23/25/36,
# -42499/42504, etc.). No newer deck release fixes this yet, so we rebuild the
# same v1.63.0 tag from source with the Go 1.26 toolchain (>= 1.26.4, patched).
# CGO_ENABLED=0 -> static binary that runs on the distroless DHI base.
# -----------------------------------------------------------------------------
FROM golang:1.26-bookworm AS deck-build
ARG DECK_VERSION=1.63.0
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 -b v${DECK_VERSION} https://github.com/Kong/deck.git /src
WORKDIR /src
# ldflags mirror deck's upstream .goreleaser.yml so `deck version` reports correctly.
RUN CGO_ENABLED=0 go build -trimpath \
  -ldflags="-s -w -X github.com/kong/deck/cmd.VERSION=v${DECK_VERSION} -X github.com/kong/deck/cmd.COMMIT=$(git rev-parse --short HEAD)" \
  -o /deck . \
  && /deck version

FROM debian:bookworm AS glibc-build

ARG GLIBC_VERSION=2.42

RUN apt-get update && apt-get install -y \
  build-essential \
  gawk \
  bison \
  python3 \
  texinfo \
  wget \
  ca-certificates \
  libgmp-dev \
  libmpfr-dev \
  libmpc-dev

WORKDIR /tmp

RUN wget http://ftp.gnu.org/gnu/libc/glibc-${GLIBC_VERSION}.tar.gz \
  && tar -xzf glibc-${GLIBC_VERSION}.tar.gz

WORKDIR /tmp/glibc-${GLIBC_VERSION}

RUN mkdir build

WORKDIR /tmp/glibc-${GLIBC_VERSION}/build

RUN ../configure \
  --prefix=/opt/glibc-${GLIBC_VERSION} \
  --disable-werror

RUN make -j$(nproc)

RUN make install

FROM debian:bookworm AS zlib-build

ARG ZLIB_VERSION=1.3.2

RUN apt-get update && apt-get install -y \
  build-essential wget

WORKDIR /tmp

RUN wget https://zlib.net/zlib-${ZLIB_VERSION}.tar.gz \
  && tar -xzf zlib-${ZLIB_VERSION}.tar.gz

WORKDIR /tmp/zlib-${ZLIB_VERSION}

RUN ./configure --prefix=/usr/local/zlib \
  && make -j$(nproc) \
  && make install

FROM debian:bookworm AS ncurses-build

ARG NCURSES_VERSION=6.5

RUN apt-get update && apt-get install -y \
  build-essential wget

WORKDIR /tmp

RUN wget https://ftp.gnu.org/pub/gnu/ncurses/ncurses-${NCURSES_VERSION}.tar.gz \
  && tar -xzf ncurses-${NCURSES_VERSION}.tar.gz

WORKDIR /tmp/ncurses-${NCURSES_VERSION}

RUN ./configure \
  --prefix=/usr/local/ncurses \
  --with-shared \
  --without-debug \
  --without-tests \
  && make -j$(nproc) \
  && make install

#FROM kong/kong-gateway:3.12.0.5-20260415-debian AS openresty-build
FROM docker.io/suriyaruk/kong-build-from-source:3.9.1-1.29.2.5 AS openresty-build
# Trivy's secret scanner reads the layer blob where a file is INTRODUCED, so an
# `rm` in the final image (a later whiteout layer) does not clear the finding —
# the example RSA key in lua-resty-rsa's POD doc stays recoverable in the COPY
# layer. Delete it HERE, before the final-stage COPY ever captures it.
RUN rm -rf /usr/local/openresty/pod/lua-resty-rsa-1.1.1
# -----------------------------------------------------------------------------
