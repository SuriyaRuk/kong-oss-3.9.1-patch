# =============================================================================
# Kong 3.9.2 (OpenResty 1.31.1.1) on Docker Hardened Image (Alpine)
# -----------------------------------------------------------------------------
# The final base `suriyaruk/alpine-base:3.24-alpine3.24-dev-dhi` is a hardened
# Alpine (musl) image. Kong's binaries from the .deb are glibc-linked, so we
# bring a glibc runtime + dynamic linker alongside musl (they coexist: musl
# binaries use /lib/ld-musl-*, glibc binaries use /lib/ld-linux-*).
# Kong itself is installed by extracting the prebuilt .deb (no apt/dpkg on the
# hardened base).
# =============================================================================

# -----------------------------------------------------------------------------
# Stage: glibc — collect a glibc runtime (+ libz) from Debian for the final
# hardened image. Only GLIBC_2.27 symbols are required by the Kong binaries,
# so Debian bookworm (glibc 2.36) is more than sufficient. Multi-arch aware.
# -----------------------------------------------------------------------------
# Debian trixie (glibc 2.41, GCC 14) is used so the harvested libstdc++ provides
# CXXABI_1.3.15, required by Kong's native libs (libada/libsimdjson_ffi/libsnappy
# are built with GCC 13+). bookworm's GCC 12 libstdc++ is too old.
FROM debian:trixie AS glibc
# libstdc++6 is needed by Kong's C++/Rust native libs (libada, libsimdjson_ffi,
# libsnappy, libatc_router); libgcc_s is part of the base. Install before the
# copy so libstdc++.so.6 lands in the multiarch lib dir we harvest.
RUN set -eux; \
  apt-get update; \
  apt-get install -y --no-install-recommends libstdc++6; \
  rm -rf /var/lib/apt/lists/*; \
  arch="$(dpkg --print-architecture)"; \
  case "$arch" in \
    amd64) mdir=x86_64-linux-gnu;  interp=/lib64/ld-linux-x86-64.so.2 ;; \
    arm64) mdir=aarch64-linux-gnu; interp=/lib/ld-linux-aarch64.so.1 ;; \
    *) echo "unsupported arch: $arch" >&2; exit 1 ;; \
  esac; \
  mkdir -p /glibc/lib; \
  cp -a /lib/"$mdir"/. /glibc/lib/; \
  cp -a /usr/lib/"$mdir"/libstdc++.so* /glibc/lib/ 2>/dev/null || true; \
  cp -aL "$interp" /glibc/ld.so; \
  printf '%s' "$interp" > /glibc/interp-path

# -----------------------------------------------------------------------------
# Stage: kong-deb — download the prebuilt Kong .deb and extract its tree.
# dpkg-deb -x unpacks the filesystem without running maintainer scripts (we set
# up the kong user ourselves in the final stage). Multi-arch aware.
# -----------------------------------------------------------------------------
FROM debian:bookworm AS kong-deb
ARG KONG_DEB_VERSION=3.9.2
ARG KONG_OPENRESTY=1.31.1.1
ARG KONG_DEB_BASEURL=https://raw.githubusercontent.com/SuriyaRuk/kong-build-from-source/main/output
RUN set -eux; \
  apt-get update; \
  apt-get install -y --no-install-recommends curl ca-certificates; \
  rm -rf /var/lib/apt/lists/*; \
  arch="$(dpkg --print-architecture)"; \
  url="${KONG_DEB_BASEURL}/kong-${KONG_DEB_VERSION}-openresty${KONG_OPENRESTY}.${arch}.deb"; \
  echo ">>> Downloading $url"; \
  curl -fSL --retry 3 -o /tmp/kong.deb "$url"; \
  mkdir -p /kongroot; \
  dpkg-deb -x /tmp/kong.deb /kongroot; \
  rm -f /tmp/kong.deb

# -----------------------------------------------------------------------------
# Stage: depfill — compute the dependency files the .deb is MISSING.
# The prebuilt .deb omits many third-party Lua/C dependency modules that Kong
# loads at runtime (resty.lmdb, resty.events, resty.kong, resty.router,
# net.url, lfs, libatc_router, ...). We diff the complete Kong 3.9.1 image
# against the extracted .deb and keep ONLY the files absent from the .deb, so
# none of Kong 3.9.2's own files are ever overwritten/downgraded.
# -----------------------------------------------------------------------------
FROM debian:bookworm AS depfill
COPY --from=ghcr.io/suriyaruk/kong-oss-3.9.1-patch:3.9.1 /usr/local /base
COPY --from=kong-deb /kongroot/usr/local /deb
RUN set -eux; \
  mkdir -p /delta; \
  cd /base; \
  for d in share/lua/5.1 lib/lua/5.1 kong/lib openresty/site/lualib; do \
    [ -d "$d" ] || continue; \
    find "$d" \( -type f -o -type l \) | while read -r f; do \
      if [ ! -e "/deb/$f" ] && [ ! -L "/deb/$f" ]; then \
        mkdir -p "/delta/$(dirname "$f")"; \
        cp -a "$f" "/delta/$f"; \
      fi; \
    done; \
  done; \
  echo "delta files: $(find /delta -type f -o -type l | wc -l)"

# -----------------------------------------------------------------------------
# Final stage: hardened Alpine base.
# -----------------------------------------------------------------------------
FROM suriyaruk/alpine-base:3.24-alpine3.24-dev-dhi
USER 0

# bash  -> required by Kong's docker-entrypoint.sh (uses bash-only syntax)
# perl  -> required by OpenResty's `resty` CLI (a Perl script) which the `kong`
#          command is built on (kong prepare/migrations/etc.)
RUN apk add --no-cache bash perl

# --- glibc runtime for the (glibc-linked) Kong/OpenResty binaries -----------
COPY --from=glibc /glibc/lib /opt/glibc/lib
COPY --from=glibc /glibc/ld.so /opt/glibc/ld.so
COPY --from=glibc /glibc/interp-path /tmp/interp-path
RUN set -eux; \
  ip="$(cat /tmp/interp-path)"; \
  mkdir -p "$(dirname "$ip")"; \
  ln -sf /opt/glibc/ld.so "$ip"; \
  rm -f /tmp/interp-path
# glibc libs + bundled OpenSSL (kong/lib) + bundled LuaJIT (openresty/luajit)
ENV LD_LIBRARY_PATH=/opt/glibc/lib:/usr/local/kong/lib:/usr/local/openresty/luajit/lib \
    PATH=/usr/local/openresty/bin:/usr/local/openresty/nginx/sbin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin

# --- Kong runtime (extracted from the .deb) ---------------------------------
COPY --from=kong-deb /kongroot/usr/local /usr/local
COPY --from=kong-deb /kongroot/etc/kong /etc/kong

# --- Kong's docker entrypoint (not shipped in the .deb) ----------------------
COPY --from=ghcr.io/suriyaruk/kong-oss-3.9.1-patch:3.9.1 /docker-entrypoint.sh /docker-entrypoint.sh

# --- Dependency modules missing from the .deb (Lua + native), delta only -----
# (See the `depfill` stage.) The WASM nginx module is intentionally excluded:
# it is compiled against the old OpenResty and is only loaded when `wasm = on`
# (off by default), so it never participates here.
COPY --from=depfill /delta/ /usr/local/

# Patch Kong's hard nginx version check. kong/meta.lua declares the accepted
# OpenResty version(s); the .deb ships OpenResty 1.31.1.1 which Kong 3.9.x does
# not list by default. Keep 1.25.3.2 so the image still boots if the runtime is
# ever swapped back.
RUN sed -i 's|nginx = { "1\.25\.3\.2" }|nginx = { "1.25.3.2", "1.31.1.1" }|' \
  /usr/local/share/lua/5.1/kong/meta.lua; \
  grep -n 'nginx = {' /usr/local/share/lua/5.1/kong/meta.lua

# Repair the .deb's `kong` CLI: its packaging step globally replaced the word
# `resty` with the absolute path `/usr/local/openresty/bin/resty`, which also
# mangled Lua identifiers (e.g. `resty_cmd` -> `/usr/local/openresty/bin/resty_cmd`),
# breaking the script. Revert to the bareword `resty` (resolved via PATH).
RUN sed -i 's|/usr/local/openresty/bin/resty|resty|g' /usr/local/bin/kong; \
  head -1 /usr/local/bin/kong

# --- kong user (uid/gid 65532, matching the previous image) ------------------
# The hardened base already owns uid/gid 65532 (the `nonroot` user), so we add
# a `kong` alias sharing that id rather than allocating a new one.
RUN set -eux; \
  grep -q '^kong:' /etc/group  || echo 'kong:x:65532:' >> /etc/group; \
  grep -q '^kong:' /etc/passwd || echo 'kong:x:65532:65532:kong:/home/kong:/bin/sh' >> /etc/passwd; \
  mkdir -p /usr/local/kong /home/kong; \
  chown -R 65532:65532 /usr/local/kong /etc/kong /home/kong; \
  chmod +x /docker-entrypoint.sh

EXPOSE 8000 8443 8001 8444 8002 8445 8003 8446 8004 8447
STOPSIGNAL SIGQUIT
USER kong
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["kong", "docker-start"]
