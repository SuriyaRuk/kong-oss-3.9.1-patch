# -----------------------------------------------------------------------------
# Drop the freshly-built OpenResty on top of the DHI base. The hardened image
# has no package manager, so the compile happened in the openresty-build stage
# above and we only copy the resulting /usr/local/openresty tree.
# Kong 3.9.x is validated against OpenResty 1.25.3.2 w/ Kong patches — after
# building, re-verify balancer/DNS, SSL cert_by_lua hooks, and stream proxies.
# -----------------------------------------------------------------------------
COPY --from=openresty-build /usr/local/openresty /usr/local/openresty
COPY --from=openresty-build /usr/local/share/lua/5.1/kong /usr/local/share/lua/5.1/kong

# Patch Kong's hard version check. kong/meta.lua declares:
#   _DEPENDENCIES = { nginx = { "1.25.3.2" } }
# and kong/cmd/utils/nginx_signals.lua fails startup if the detected OpenResty
# doesn't satisfy that list. We add 1.29.2.3 so both the legacy and upgraded
# binaries are accepted. Keep 1.25.3.2 in the list so the image still boots if
# the COPY --from=openresty-build layer is ever skipped.
RUN sed -i 's|nginx = { "1\.25\.3\.2" }|nginx = { "1.25.3.2", "1.29.2.5" }|' \
  /usr/local/share/lua/5.1/kong/meta.lua; \
  grep -n 'nginx = {' /usr/local/share/lua/5.1/kong/meta.lua

